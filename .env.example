# Copier ce fichier en .env puis renseigner les valeurs. Ne JAMAIS versionner .env.
# Lu par docker-compose et par le profil Spring "dev".

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartshop
DB_USERNAME=smartshop
DB_PASSWORD=change-me

# --- JWT (au moins 32 caracteres) ---
# Generer avec : openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-value-of-32-chars-min
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- Backend ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
